# ─── Agents (set as GitHub Actions secrets) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # service_role key — never expose publicly

# Twitter v2 API (optional — skip to disable Twitter fetching)
TWITTER_BEARER_TOKEN=AAAA...

# ─── Dashboard (set in Vercel / .env.local) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # anon key — safe for browser
